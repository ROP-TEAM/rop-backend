                },
                "email": {
                    "type": "string"
                },
                "google_id": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "is_need_on_boarding": {
                    "type": "boolean"
                },
                "is_validated": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "tel": {
                    "type": "string"
                },
                "updatedAt": {
                    "type": "string"
                }
