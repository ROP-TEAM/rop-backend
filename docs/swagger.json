                },
                "daily_break_time_start": {
                    "type": "integer"
                },
                "daily_work_time_end": {
                    "type": "integer"
                },
                "daily_work_time_start": {
                    "type": "integer"
                },
                "end_latitude": {
                    "type": "number"
                },
                "end_longitude": {
                    "type": "number"
                },
                "max_task": {
                    "type": "integer"
                },
                "model": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "plate_number": {
                    "type": "string"
                },
                "start_latitude": {
                    "type": "number"
                },
                "start_longitude": {
                    "type": "number"
                }
            }
        },
        "dto.GroupCreateOrder": {
            "type": "object",
            "properties": {
                "orders": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.CreateOrder"
                    }
                },
                "plan_id": {
                    "type": "string"
                }
            }
        },
        "dto.GroupCreateTagSkill": {
            "type": "object",
            "properties": {
                "plan_id": {
                    "type": "string"
                },
                "skills": {
                    "type": "array",
