                },
                "type": {
                    "type": "string"
                }
            }
        },
        "models.OnboardingPayload": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string",
                    "example": "123 ถนนสุขุมวิท"
                },
                "companyName": {
                    "type": "string",
                    "example": "ABC Co."
                },
                "companyType": {
                    "type": "string",
                    "example": "SME"
                },
                "district": {
                    "type": "string",
                    "example": "Pathum Wan"
                },
                "postalCode": {
                    "type": "string",
                    "example": "10330"
                },
                "province": {
                    "type": "string",
                    "example": "Bangkok"
                },
                "subDistrict": {
                    "type": "string",
                    "example": "Lumphini"
                }
            }
        },
        "models.User": {
            "type": "object",
            "properties": {
                "company": {
